{
  "name": "scaeli-daily-app",
  "version": "1.4.0",
  "private": true,
  "description": "Scaeli Daily para Google Play y App Store (Capacitor). La app es la misma web de la carpeta de arriba.",
  "scripts": {
    "copiar": "node copiar.mjs",
    "sync": "node copiar.mjs && npx cap sync",
    "android": "node copiar.mjs && npx cap sync android && npx cap open android",
    "ios": "node copiar.mjs && npx cap sync ios && npx cap open ios",
    "iconos": "npx @capacitor/assets generate --iconBackgroundColor '#5A1524' --iconBackgroundColorDark '#5A1524' --splashBackgroundColor '#170A0D' --splashBackgroundColorDark '#170A0D'"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@revenuecat/purchases-capacitor": "^14.0.0",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0"
  }
}
